rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // RULES GUDANG HALF KOPI (toko-kopi-8abbd)
    // Disesuaikan untuk operasional toko kopi
    // ==============================================================

    // 1. Health Check & Live Status
    match /_health/{docId} {
      allow read, write: if true;
    }

    // 2. Koleksi Bahan Baku Gudang (Biji Kopi, Susu, Sirup, Cups)
    match /items/{itemId} {
      allow read, write: if true;
    }

    // 3. Koleksi Mutasi Stok (Stok Masuk, Stok Keluar Barista, Stock Opname)
    match /stock_transactions/{transactionId} {
      allow read, write: if true;

      // Sub-koleksi rincian bahan transaksi
      match /items/{itemSubId} {
        allow read, write: if true;
      }
    }

    // 4. Koleksi Master Kategori Bahan
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 5. Koleksi Master Supplier & Vendor
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // 6. Koleksi Pengguna (Admin & Pegawai)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 7. Fallback untuk Dokumen Lainnya
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
