{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && node -e \"const fs=require('fs');fs.cpSync('public','dist',{recursive:true});\"",
        "dev": "vite",
        "deploy:rules": "firebase.cmd deploy --only firestore:rules,database",
        "firebase:login": "firebase.cmd login",
        "firebase:status": "firebase.cmd projects:list"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "firebase": "^13.0.0"
    }
}
